%YAML 1.2
---
scope: source.shell.bash.embedded.makefile.expansion
version: 2
hidden: true

extends: Packages/ShellScript/Bash.sublime-syntax

contexts:

  main:
    - include: statements

  expression-variable-chars:
    - meta_prepend: true
    - include: Packages/Makefile/Makefile.sublime-syntax#interpolations

  parameter-expansions:
    - meta_append: true
    - include: Packages/Makefile/Makefile.sublime-syntax#expansions

  string-single-quoted-prototype:
    - meta_prepend: true
    - include: Packages/Makefile/Makefile.sublime-syntax#escaped-dollars
    - include: Packages/Makefile/Makefile.sublime-syntax#interpolations

variables:

  # ShellScript variables
  # ---------------------

  # makefile or shell interpolation
  is_interpolation: (?=\${1,2}[({\[{{identifier_char}}{{special_variables}}{{var_auto_chars}}]|`)
  # shell specific interpolation
  interpolation_punct: \${2}

  # Indentation and whitespace patterns
  no_indent: ^{{recipe_prefix}}
  tab_indent: ^{{recipe_prefix}}\t*

  # Makefile variables
  # ------------------

  recipe_prefix: \t

  # makefile auto variables
  var_auto_chars: '@%<\?\^\+\|\*'
