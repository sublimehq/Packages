%YAML 1.2
# http://www.sublimetext.com/docs/3/syntax.html
# https://www.gnu.org/software/make/manual/make.html
--- #---------------------------------------------------------------------------
# Converted from Makefile Improved by Kay-Uwe (Kiwi) Lorenz
# Includes a few improvement like special-target, a bit more shell command,
# better variable recognition, fix ifeq/ifneq missing highlight ...
# Rewritten by Raoul Wols on May 2017.
#
# All number references refer to the "Make manual" (see link above).
name: Makefile
scope: source.makefile
version: 2

file_extensions:
  - mk
  - mak
  - make

hidden_file_extensions:
  - GNUmakefile
  - Makefile
  - Makefile.am
  - Makefile.in
  - OCamlMakefile

first_line_match: |-
  (?xi:
    ^ \#! .* \bmake\b |                          # shebang
    ^ \s* \# .*? -\*- .*? \bmakefile\b .*? -\*-  # editorconfig
  )

contexts:

  # 3.1 What Makefiles Contain
  # Makefiles contain five kinds of things: explicit rules, implicit rules,
  # variable definitions, directives, and comments.
  main:
    - include: comments
    - include: merge-conflict-markers
    - include: line-continuations
    - include: definition-directives
    - include: conditional-directives
    - include: definitions

  definitions:
    - match: '{{word_begin}}'
      branch_point: definitions
      branch:
        - inside-global-variable-definition-name
        - inside-rule-target

###[ COMMENTS ]################################################################

  comments:
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      push: inside-comment

  comment:
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      set: inside-comment

  inside-comment:
    - meta_content_scope: comment.line.number-sign.makefile
    - include: line-continuations
    - match: \\\\
    # note: meta.eol is required for syntax based folding
    - match: $\n?
      scope: comment.line.number-sign.makefile meta.eol.makefile
      pop: 1

###[ MERGE CONFLICT MARKERS ]##################################################

  merge-conflict-markers:
    # see also: Diff.sublime-syntax#conflict-markers
    - match: ^(<{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.begin.diff
      captures:
        1: punctuation.section.block.begin.diff
        2: entity.name.section.diff
    - match: ^(>{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.end.diff
      captures:
        1: punctuation.section.block.end.diff
        2: entity.name.section.diff
    - match: ^(\|{7}|={7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.separator.diff
      captures:
        1: punctuation.section.block.diff
        2: entity.name.section.diff

###[ RULE DEFINITIONS ]########################################################

  inside-rule-target:
    # Anything before the colon is part of the rule's name.
    - meta_content_scope: meta.function.makefile entity.name.function.makefile
    - match: \s*(::?)
      captures:
        1: keyword.operator.assignment.makefile
      set: after-rule-target
    - include: line-continuations
    - include: escaped-chars
    - include: escaped-dollars
    - include: expansions
    - include: percentage-placeholders

  after-rule-target:
    - meta_scope: meta.function.makefile
    - include: line-continuations
    # target-specific variable (parsed by main context)
    - match: (?=(?:override|(?:un)?(?:define|export)){{word_break}}|[^=#]+{{var_or_shell_assign}})
      pop: 1
    # prerequisites
    - match: (?=\S)
      set: inside-rule-prerequisites
    # recipes
    - match: $\n?
      set: inside-rule-body

  inside-rule-prerequisites:
    - meta_include_prototype: false
    - meta_content_scope: meta.function.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      set: inside-rule-comment
    - match: \s*$\n?
      scope: meta.function.makefile
      set: inside-rule-body
    - match: (\s*(;))(\s*(-@?|@-?))?
      captures:
        1: meta.function.makefile
        2: punctuation.terminator.makefile
        3: meta.function.body.makefile
        4: keyword.operator.suppress.makefile
      set:
        - inside-rule-body
        - inside-shell
    - include: line-continuations
    - include: escaped-chars
    - include: second-escaped-dollars
    - include: second-interpolations
    - include: percentage-placeholders

  inside-rule-comment:
    - meta_scope: meta.function.makefile
    - meta_content_scope: comment.line.number-sign.makefile
    - match: $\n?
      scope: comment.line.number-sign.makefile
      set: inside-rule-body

  inside-rule-body:
    - meta_content_scope: meta.function.body.makefile
    - include: comments
    - include: merge-conflict-markers
    - include: conditional-directives
    - match: ^({{receipe_prefix}})(?:\s*(-@?|@-?))?
      captures:
        1: punctuation.definition.recipe.makefile
        2: keyword.operator.suppress.makefile
      push: inside-shell
    - match: ^(?!\n)
      pop: 1

###[ VARIABLE DEFINITIONS ]####################################################

  inside-global-variable-definition-name:
    - meta_content_scope: meta.variable.makefile variable.other.makefile
    - include: inside-variable-definition-name
    - match: ':'
      fail: definitions

  inside-variable-definition-name:
    - meta_content_scope: meta.variable.makefile variable.other.makefile
    - match: \s*({{shell_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: inside-shell
    - match: \s*({{var_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: variable-value
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: expansions

  variable-value:
    - match: ((?:bash|sh|zsh)\s+-c\s+)(['"`])
      captures:
        1: meta.string.makefile string.unquoted.makefile
        2: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.begin.makefile
      embed: shell-content
      embed_scope: meta.string.makefile meta.interpolation.makefile source.shell.embedded.makefile
      escape: (?!<\\)\2
      escape_captures:
        0: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.end.makefile
    - match: ''
      set: inside-variable-value

  inside-variable-value:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

###[ DIRECTIVES ]##############################################################

  definition-directives:
    # definition directives
    - match: (override){{word_break}}
      captures:
        1: keyword.control.override.makefile
    - match: (define)(?:\s+|{{word_break}})
      scope: meta.directive.define.makefile
      captures:
        1: keyword.control.define.makefile
      push: inside-define-directive-name
    - match: (export)(?:\s+|{{word_break}})
      scope: meta.directive.export.makefile
      captures:
        1: keyword.control.export.makefile
      push: inside-export-directive-name
    - match: (undefine)(?:\s+|{{word_break}})
      scope: meta.directive.undefine.makefile
      captures:
        1: keyword.control.undefine.makefile
      push: inside-undefine-directive-name
    - match: (unexport)(?:\s+|{{word_break}})
      scope: meta.directive.undefine.makefile
      captures:
        1: keyword.control.unexport.makefile
      push: inside-undefine-directive-name
    - match: (endef)(?:\s+|{{word_break}})
      captures:
        1: invalid.illegal.stray.endef.makefile
    - match: (vpath)(?:\s+|{{word_break}})
      scope: meta.directive.vpath.makefile
      captures:
        1: keyword.control.vpath.makefile
      push: inside-vpath-pattern
    # include directives
    - match: (-)(include)(?:\s+|{{word_break}})
      scope: meta.directive.include.makefile
      captures:
        1: keyword.operator.suppress.makefile
        2: keyword.control.import.makefile
      push: inside-include-directive
    - match: (s?include)(?:\s+|{{word_break}})
      scope: meta.directive.include.makefile
      captures:
        1: keyword.control.import.makefile
      push: inside-include-directive
    - match: (-?)(load)(?:\s+|{{word_break}})
      scope: meta.directive.load.makefile
      captures:
        1: keyword.operator.suppress.makefile
        2: keyword.control.import.makefile
      push: inside-load-directive

  inside-define-directive-name:
    - meta_content_scope: meta.directive.define.makefile meta.variable.makefile variable.other.makefile
    - match: ({{var_or_shell_assign}})?\s*\n
      captures:
        1: keyword.operator.assignment.makefile
      set: inside-define-directive-value
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

  inside-define-directive-value:
    - meta_include_prototype: false
    - meta_scope: meta.directive.define.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: ^\s*(endef){{word_break}}
      captures:
        1: keyword.control.endef.makefile
      pop: 1
    # keep in balance with nested define statements
    # see: https://github.com/sublimehq/Packages/issues/1998
    - match: ^\s*define{{word_break}}
      push: inside-nested-define-directive
    - include: merge-conflict-markers

  inside-nested-define-directive:
    - meta_include_prototype: false
    - match: ^\s*endef{{word_break}}
      pop: 1
    - include: merge-conflict-markers

  inside-export-directive-name:
    - meta_content_scope: meta.directive.export.makefile meta.variable.makefile variable.other.makefile
    - match: \s*({{var_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: inside-export-variable-value
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

  inside-export-variable-value:
    - meta_include_prototype: false
    - meta_scope: meta.directive.export.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - include: inside-variable-value

  inside-include-directive:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.include.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations
    - include: glob-placeholders
    - match: \s+
      scope: meta.directive.include.makefile
      set: inside-include-directive

  inside-load-directive:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.load.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations
    - include: glob-placeholders
    - match: (\()([^)]*)(\))
      scope: meta.parens.makefile
      captures:
        1: punctuation.section.parens.begin.makefile
        2: entity.name.symbol.makefile
        3: punctuation.section.parens.end.makefile
    - match: \s+
      scope: meta.directive.load.makefile
      set: inside-load-directive

  inside-undefine-directive-name:
    - meta_content_scope: meta.directive.undefine.makefile meta.variable.makefile variable.other.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

  inside-vpath-pattern:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.vpath.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations
    - include: glob-placeholders
    - match: \s+
      scope: meta.directive.vpath.makefile
      set: inside-vpath-directory

  inside-vpath-directory:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.vpath.makefile meta.string.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

###[ CONDITIONAL DIRECTIVES ]##################################################

  conditional-directives:
    # 7.2 Syntax of Conditionals
    - match: (ifn?def)(?:\s+|{{word_break}})
      captures:
        1: keyword.control.conditional.if.makefile
      push: ifdef-directive-condition
    - match: ifn?eq{{word_break}}
      scope: keyword.control.conditional.if.makefile
      push: ifeq-directive-condition
    - match: else{{word_break}}
      scope: meta.directive.conditional.else.makefile keyword.control.conditional.else.makefile
      branch_point: maybe-elseif
      branch:
        - else-if-directive
        - else-directive
    - match: endif{{word_break}}
      scope: meta.directive.conditional.endif.makefile keyword.control.conditional.endif.makefile

  else-if-directive:
    # Note: required for syntax based folding
    # When followed by an if directive else keyword acts as fold region terminator,
    # but only the eol after the if directive starts a new fold region.
    - include: comments
    - match: (ifn?def)(?:\s+|{{word_break}})
      captures:
        1: keyword.control.conditional.if.makefile
      set: ifdef-directive-condition
    - match: ifn?eq{{word_break}}
      scope: keyword.control.conditional.if.makefile
      set: ifeq-directive-condition
    - match: (?=\S)
      fail: maybe-elseif

  else-directive:
    # Note: required for syntax based folding
    # The eol after a plain else directive starts a new fold region.
    - meta_content_scope: meta.directive.conditional.else.makefile
    - match: \s*$
      scope: meta.directive.conditional.else.makefile meta.eol.makefile
      pop: 1
    - include: comments
    - include: line-continuations

  ifdef-directive-condition:
    - meta_scope: meta.directive.conditional.if.makefile
    - meta_content_scope: meta.variable.makefile variable.other.makefile
    - include: if-directive-end
    - include: escaped-chars
    - include: escaped-dollars
    - include: expansions

  ifeq-directive-condition:
    - meta_scope: meta.directive.conditional.if.makefile
    - include: if-directive-end
    - match: \(
      scope: punctuation.section.group.begin.makefile
      push: inside-ifeq-group
    - match: \"
      scope: punctuation.definition.string.begin.makefile
      push: inside-ifeq-double-quoted-arg
    - match: \'
      scope: punctuation.definition.string.begin.makefile
      push: inside-ifeq-single-quoted-arg
    - match: '[^\s#]+'
      scope: invalid.illegal.stray.makefile

  inside-ifeq-group:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.group.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.group.end.makefile
      pop: 1
    - include: continuation-or-eol-pop
    - include: escaped-dollars
    - include: interpolations
    - include: comma-separators

  inside-ifeq-double-quoted-arg:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.string.makefile string.quoted.double.makefile
    - match: \"
      scope: punctuation.definition.string.end.makefile
      pop: 1
    - match: $\n?
      scope: meta.eol.makefile invalid.illegal.unclosed-string.makefile
      pop: 1
    - include: line-continuations
    - include: escaped-dollars
    - include: interpolations

  inside-ifeq-single-quoted-arg:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.string.makefile string.quoted.single.makefile
    - match: \'
      scope: punctuation.definition.string.end.makefile
      pop: 1
    - match: $\n?
      scope: meta.eol.makefile invalid.illegal.unclosed-string.makefile
      pop: 1
    - include: line-continuations
    - include: escaped-dollars
    - include: interpolations

  if-directive-end:
    # Note: required for syntax based folding
    # The eol after an if directive starts a new fold region.
    - match: \s*$
      scope: meta.eol.makefile
      pop: 1
    - include: comments
    - include: line-continuations

###[ STRINGS ]#################################################################

  string-content:
    - match: \(
      push: inside-string-paren
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: escaped-dollars
    - include: interpolations

  inside-string-paren:
    - match: \)
      pop: 1
    - include: string-content

  second-string-content:
    - match: \(
      push: inside-second-string-paren
    - include: continuation-or-eol-pop
    - include: escaped-chars
    - include: second-escaped-dollars
    - include: second-interpolations

  inside-second-string-paren:
    - match: \)
      pop: 1
    - include: second-string-content

###[ SINGLE EXPANSIONS ]#######################################################

  interpolations:
    - match: '{{is_interpolation}}'
      push: inside-interpolation

  inside-interpolation:
    - clear_scopes: 1
    - meta_include_prototype: false
    - include: expansions
    - include: immediately-pop

  expansions:
    # makefile command expansions
    - match: (\$)(\()((call)\s+)
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-call-function-expansion
    - match: (\$)(\()(({{pattern_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-pattern-function-expansion
    - match: (\$)(\()((wildcard)\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-wildcard-function-expansion
    - match: (\$)(\()(({{message_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-message-function-expansion
    - match: (\$)(\()(({{builtin_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-function-expansion
    - match: (\$)(\()((shell)\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-shell-expansion
    # makefile variable expansions
    - match: (\$)(\()([{{var_auto_chars}}][DF]?)(\))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: variable.language.automatic.makefile
        4: punctuation.section.interpolation.end.makefile
    - match: (\$)(\{)([{{var_auto_chars}}][DF]?)(\})
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: variable.language.automatic.makefile
        4: punctuation.section.interpolation.end.makefile
    - match: (\$)(\()
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: inside-variable-expansion-name-paren
    - match: (\$)(\{)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: inside-variable-expansion-name-brace
    - match: (\$)(?:([{{var_auto_chars}}])|([[:alpha:]]))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: variable.language.automatic.makefile
        3: variable.other.makefile

  inside-call-function-expansion:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.makefile variable.function.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: \,
      scope: meta.function-call.makefile punctuation.separator.makefile
      set: inside-function-expansion
    - include: eol-pop
    - include: line-continuations
    - include: escaped-chars
    - include: escaped-dollars
    - include: expansions

  inside-message-function-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: string-content

  inside-pattern-function-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - include: inside-function-expansion
    - include: percentage-placeholders

  inside-wildcard-function-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: inside-function-expansion
    - include: glob-placeholders

  inside-function-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: comma-separators
    - include: string-content

  inside-shell-expansion:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile source.shell.embedded.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: inside-shell

  inside-variable-expansion-name-brace:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: variable.other.makefile
    - match: \}
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - match: ':'
      scope: punctuation.definition.substitution.makefile
      set: inside-variable-substitution-brace
    - include: variable-expansion-content

  inside-variable-substitution-brace:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \}
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: =
      scope: meta.interpolation.makefile keyword.operator.assignment.makefile
      set: inside-variable-replacement-brace
    - include: variable-substitution-content

  inside-variable-replacement-brace:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \}
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - include: variable-substitution-content

  inside-variable-expansion-name-paren:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: variable.other.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - match: ':'
      scope: punctuation.definition.substitution.makefile
      set: inside-variable-substitution-paren
    - include: variable-expansion-content

  inside-variable-substitution-paren:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: =
      scope: meta.interpolation.makefile keyword.operator.assignment.makefile
      set: inside-variable-replacement-paren
    - include: variable-substitution-content

  inside-variable-replacement-paren:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - include: variable-substitution-content

  variable-expansion-content:
    - include: eol-pop
    - include: line-continuations
    - include: escaped-chars
    - include: escaped-dollars
    - include: expansions
    - include: percentage-placeholders

  variable-substitution-content:
    - include: string-content
    - include: percentage-placeholders

###[ SECOND EXPANSIONS ]#######################################################

  # Note:
  #  - idendical to expansions, but with $$ punctuation
  #  - valid only within rule prerequisites

  second-interpolations:
    - match: '{{is_2nd_interpolation}}'
      push: second-interpolation

  second-interpolation:
    - clear_scopes: 1
    - meta_include_prototype: false
    - include: second-expansions
    - include: immediately-pop

  second-expansions:
    # makefile command expansions
    - match: (\$\$?)(\()((call)\s+)
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-call-function-second-expansion
    - match: (\$\$?)(\()(({{pattern_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-pattern-function-second-expansion
    - match: (\$\$?)(\()((wildcard)\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-wildcard-function-second-expansion
    - match: (\$\$?)(\()(({{message_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-message-function-second-expansion
    - match: (\$\$?)(\()(({{builtin_functions}})\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-function-second-expansion
    - match: (\$\$?)(\()((shell)\s+)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: meta.function-call.makefile
        4: support.function.builtin.makefile
      push: inside-shell-second-expansion
    # makefile variable expansions
    - match: (\$\$?)(\()([{{var_auto_chars}}][DF]?)(\))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: variable.language.automatic.makefile
        4: punctuation.section.interpolation.end.makefile
    - match: (\$\$?)(\{)([{{var_auto_chars}}][DF]?)(\})
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
        3: variable.language.automatic.makefile
        4: punctuation.section.interpolation.end.makefile
    - match: (\$\$?)(\()
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: inside-variable-second-expansion-name-paren
    - match: (\$\$?)(\{)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: inside-variable-second-expansion-name-brace
    - match: (\$\$?)(?:([{{var_auto_chars}}])|([[:alpha:]]))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: variable.language.automatic.makefile
        3: variable.other.makefile

  inside-call-function-second-expansion:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.makefile variable.function.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: \,
      scope: meta.function-call.makefile punctuation.separator.makefile
      set: inside-function-second-expansion
    - include: eol-pop
    - include: line-continuations
    - include: escaped-chars
    - include: second-expansions

  inside-message-function-second-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: second-string-content

  inside-pattern-function-second-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - include: inside-function-second-expansion
    - include: percentage-placeholders

  inside-wildcard-function-second-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: inside-function-second-expansion
    - include: glob-placeholders

  inside-function-second-expansion:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: comma-separators
    - include: second-string-content

  inside-shell-second-expansion:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: meta.function-call.arguments.makefile source.shell.embedded.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - include: inside-shell

  inside-variable-second-expansion-name-brace:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: variable.other.makefile
    - match: \}
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - match: ':'
      scope: punctuation.definition.substitution.makefile
      set: inside-variable-second-substitution-brace
    - include: variable-second-expansion-content

  inside-variable-second-substitution-brace:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \}
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: =
      scope: meta.interpolation.makefile keyword.operator.assignment.makefile
      set: inside-variable-second-replacement-brace
    - include: variable-second-substitution-content

  inside-variable-second-replacement-brace:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \}
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - include: variable-second-substitution-content

  inside-variable-second-expansion-name-paren:
    - meta_scope: meta.interpolation.makefile
    - meta_content_scope: variable.other.makefile
    - match: \)
      scope: punctuation.section.interpolation.end.makefile
      pop: 1
    - match: ':'
      scope: punctuation.definition.substitution.makefile
      set: inside-variable-second-substitution-paren
    - include: variable-second-expansion-content

  inside-variable-second-substitution-paren:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - match: =
      scope: meta.interpolation.makefile keyword.operator.assignment.makefile
      set: inside-variable-second-replacement-paren
    - include: variable-second-substitution-content

  inside-variable-second-replacement-paren:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: \)
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - include: variable-second-substitution-content

  variable-second-expansion-content:
    - include: eol-pop
    - include: line-continuations
    - include: escaped-chars
    - include: second-escaped-dollars
    - include: second-expansions
    - include: percentage-placeholders

  variable-second-substitution-content:
    - include: second-string-content
    - include: percentage-placeholders

###[ GLOB PATTERNS ]###########################################################

  glob-placeholders:
    # 4.4 Using Wildcard Characters in File Names
    # Note: Copied from Bash.sublime-syntax
    - match: \*
      scope: constant.other.wildcard.asterisk.makefile
    - match: \?
      scope: constant.other.wildcard.questionmark.makefile
    - match: (?=\[)
      branch_point: glob-character-class
      branch:
        - glob-character-class
        - glob-character-class-fallback

  glob-character-class:
    - match: (\[)([!^]?)
      captures:
        1: punctuation.definition.character-class.begin.glob.makefile
        2: keyword.operator.logical.glob.makefile
      set:
        - glob-character-class-body
        - glob-character-class-begin

  glob-character-class-body:
    - meta_scope: meta.character-class.glob.makefile
    - match: (?!\S) # also fail at eof
      fail: glob-character-class
    - include: glob-character-class-end
    - include: glob-character-class-content

  glob-character-class-begin:
    - meta_include_prototype: false
    # a range may start with `]` at the beginning of a set
    - match: (?:(\\.)|.)(-)(?:(\\.)|[^\]$]|(?!\]))
      scope: constant.other.range.glob.makefile
      captures:
        1: constant.character.escape.glob.makefile
        2: punctuation.separator.sequence.glob.makefile
        3: constant.character.escape.glob.makefile
      pop: 1
    # the following are treated literal at the beginning of a set
    - match: '[]-]'
      pop: 1
    - include: immediately-pop

  glob-character-class-end:
    - match: \]
      scope: punctuation.definition.character-class.end.glob.makefile
      pop: 1

  glob-character-class-fallback:
    - meta_include_prototype: false
    - match: \[
      pop: 1

  glob-character-class-content:
    - match: \[\.(?=\S*\.\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: glob-character-class-collate-body
    - match: \[=(?=\S*=\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: glob-character-class-equivalence-body
    - match: \[:(?=(?:{{posix_classes}}|\$+(?:\{.*?\}|\w+)):\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: glob-character-class-posix-body
    - match: (?:(\\.)|[^\\\]])?(-)(?:(\\.)|[^\]$]|(?!\]))
      scope: constant.other.range.glob.makefile
      captures:
        1: constant.character.escape.glob.makefile
        2: punctuation.separator.sequence.glob.makefile
        3: constant.character.escape.glob.makefile
    - include: escaped-chars
    - include: expansions
    - include: continuation-or-eol-pop

  glob-character-class-collate-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.collate.glob.makefile
    - match: \.\]
      scope: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: escaped-chars
    - include: expansions
    - include: continuation-or-eol-pop

  glob-character-class-equivalence-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.equivalence.glob.makefile
    - match: =\]
      scope: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: escaped-chars
    - include: expansions
    - include: continuation-or-eol-pop

  glob-character-class-posix-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.posix.glob.makefile
    - match: ({{posix_classes}}?)(:\])
      captures:
        1: constant.other.character-class.posix.glob.makefile
        2: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: escaped-chars
    - include: expansions
    - include: continuation-or-eol-pop

###[ LITERALS ]################################################################

  comma-separators:
    - match: \s*(\,)\s*
      captures:
        1: punctuation.separator.makefile
      push: clear-pop

  escaped-chars:
    - match: \\.
      scope: constant.character.escape.makefile

  escaped-dollars:
    - match: \${2}
      scope: constant.character.escape.makefile

  second-escaped-dollars:
    - match: \${4}
      scope: constant.character.escape.makefile

  percentage-placeholders:
    - match: \%
      scope: variable.language.makefile

###[ SHELLSCRIPT ]#############################################################

  inside-shell:
    - meta_content_scope: source.shell.embedded.makefile
    - include: eol-pop
    - include: shell-content

  shell-content:
    - include: Packages/Makefile/Embeddings/Shell (for Makefile).sublime-syntax
      apply_prototype: true

###[ PROTOTYPES ]##############################################################

  continuation-or-eol-pop:
    - include: eol-pop
    - include: comment
    - include: line-continuations

  eol-pop:
    - match: $
      pop: 1

  clear-pop:
    - clear_scopes: 2
    - meta_include_prototype: false
    - match: ''
      pop: 1

  immediately-pop:
    - meta_include_prototype: false
    - match: ''
      pop: 1

  line-continuations:
    - match: (\\)$
      captures:
        1: punctuation.separator.continuation.line.makefile
      push: inside-line-continuation

  inside-line-continuation:
    - meta_include_prototype: false
    - match: ^
      pop: 1

###############################################################################

variables:

  receipe_prefix: \t

  word_begin: (?=\S)
  word_break: (?![^\s:#!?+=])

  shell_assign: '!='
  var_assign: (?:\?|\+|:{1,3})?=
  var_or_shell_assign: (?:!|\?|\+|:{1,3})?=

  is_interpolation: (?=\$[({{{var_auto_chars}}[:alpha:]])
  is_2nd_interpolation: (?=\$\$?[({{{var_auto_chars}}[:alpha:]])

  var_auto_chars: '@%<\?\^\+\|\*'

  builtin_functions: |-
    (?x:
      abspath
    | addprefix
    | addsuffix
    | and
    | basename
    | dir
    | eval
    | file
    | findstring
    | firstword
    | flavor
    | foreach
    | guile
    | if
    | intcmp
    | join
    | lastword
    | notdir
    | or
    | origin
    | realpath
    | sort
    | strip
    | subst
    | suffix
    | value
    | word
    | wordlist
    | words
    )

  message_functions: |-
    (?x:
      info
    | warning
    | error
    )

  pattern_functions: |-
    (?x:
      filter-out
    | filter
    | patsubst
    )

  posix_classes: |-
    (?x:
      alnum
    | alpha
    | blank
    | cntrl
    | digit
    | graph
    | lower
    | print
    | punct
    | space
    | upper
    | xdigit
    )
