%YAML 1.2
---
# https://www.gnu.org/software/make/manual/make.html
# https://www.sublimetext.com/docs/syntax.html
name: Makefile
scope: source.makefile
version: 2

extends: Makefile (Bash).sublime-syntax

file_extensions:
  - mk
  - mak
  - make

hidden_file_extensions:
  - GNUmakefile
  - Makefile
  - Makefile.am
  - Makefile.in
  - OCamlMakefile

first_line_match: |-
  (?xi:
    ^ \#! .* \bmake\b |                          # shebang
    ^ \s* \# .*? -\*- .*? \bmakefile\b .*? -\*-  # editorconfig
  )
