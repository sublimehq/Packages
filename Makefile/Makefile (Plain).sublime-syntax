    # Note: Copied from Bash.sublime-syntax
    - match: (?=\[)
      branch_point: second-glob-character-class
      branch:
        - second-glob-character-class
        - glob-character-class-fallback
    - match: \*
      scope: constant.other.wildcard.asterisk.makefile
    - match: \?
      scope: constant.other.wildcard.questionmark.makefile

  second-glob-character-class:
    - clear_scopes: 2
    - meta_include_prototype: false
    - meta_scope: meta.string.glob.makefile meta.character-class.glob.makefile string.unquoted.makefile
    - match: (\[)([!^]?)
      captures:
        1: punctuation.definition.character-class.begin.glob.makefile
        2: keyword.operator.logical.glob.makefile
      push:
        - second-glob-character-class-body
        - glob-character-class-begin

  second-glob-character-class-body:
    - match: (?!\S) # also fail at eof
      fail: second-glob-character-class
    - include: glob-character-class-end
    - include: continuation-or-eol-pop
    - include: second-glob-character-class-content

  second-glob-character-class-content:
    - match: \[\.(?=\S*\.\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: second-glob-character-class-collate-body
    - match: \[=(?=\S*=\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: second-glob-character-class-equivalence-body
    - match: \[:(?=(?:{{posix_classes}}|\$+(?:\{.*?\}|\w+)):\])
      scope: punctuation.definition.character-class.begin.glob.makefile
      push: second-glob-character-class-posix-body
    - match: (?:(\\.)|[^\\\]])?(-)(?:(\\.)|[^\]$]|(?!\]))
      scope: constant.other.range.glob.makefile
      captures:
        1: constant.character.escape.glob.makefile
        2: punctuation.separator.sequence.glob.makefile
        3: constant.character.escape.glob.makefile
    - include: second-string-content

  second-glob-character-class-collate-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.collate.glob.makefile
    - match: \.\]
      scope: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: second-string-content

  second-glob-character-class-equivalence-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.equivalence.glob.makefile
    - match: =\]
      scope: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: second-string-content

  second-glob-character-class-posix-body:
    - meta_scope: meta.character-class.glob.makefile
    - meta_content_scope: constant.other.character-class.posix.glob.makefile
    - match: ({{posix_classes}}?)(:\])
      captures:
        1: constant.other.character-class.posix.glob.makefile
        2: punctuation.definition.character-class.end.glob.makefile
      pop: 1
    - include: second-string-content

###[ SECOND EXPANSIONS / MAKE PATTERNS ]#######################################

  brace-second-pattern-content:
    - match: \{
      push: second-pattern-brace-body
    - include: second-pattern-content

  second-pattern-brace-body:
    - match: \}
      pop: 1
    - include: continuation-or-eol-pop
    - include: brace-second-pattern-content

  paren-second-pattern-content:
    - match: \(
      push: second-pattern-paren-body
    - include: second-pattern-content

  second-pattern-paren-body:
    - match: \)
      pop: 1
    - include: continuation-or-eol-pop
    - include: paren-second-pattern-content

  second-pattern-content:
    - include: second-string-content
    - include: percentage-placeholders

###[ SECOND EXPANSIONS / STRINGS ]#############################################

  brace-second-string-content:
    - match: \{
      push: second-string-brace-body
    - include: second-string-content

  second-string-brace-body:
    - match: \}
      pop: 1
    - include: continuation-or-eol-pop
    - include: brace-second-string-content

  paren-second-string-content:
    - match: \(
      push: second-string-paren-body
    - include: second-string-content

  second-string-paren-body:
    - match: \)
      pop: 1
    - include: continuation-or-eol-pop
    - include: paren-second-string-content

  second-string-content:
    - include: escaped-chars
    - include: second-escaped-dollars
    - include: second-interpolations
    - include: interpolations

###[ SECOND EXPANSIONS / VARIABLE PATTERNS ]###################################

  brace-second-variable-pattern-content:
    - match: \{
      push: second-variable-pattern-brace-body
    - include: second-variable-pattern-content

  second-variable-pattern-brace-body:
    - match: \}
      pop: 1
    - include: continuation-or-eol-pop
    - include: brace-second-variable-pattern-content

  paren-second-variable-pattern-content:
    - match: \(
      push: second-variable-pattern-paren-body
    - include: second-variable-pattern-content

  second-variable-pattern-paren-body:
    - match: \)
      pop: 1
    - include: continuation-or-eol-pop
    - include: paren-second-variable-pattern-content

  second-variable-pattern-content:
    - include: second-variable-name-content
    - include: percentage-placeholders

###[ SECOND EXPANSIONS / VARIABLE NAMES ]######################################

  brace-second-variable-name-content:
    - match: \{
      push: second-variable-name-brace-body
    - include: second-variable-name-content

  second-variable-name-brace-body:
    - match: \}
      pop: 1
    - include: continuation-or-eol-pop
    - include: brace-second-variable-name-content

  paren-second-variable-name-content:
    - match: \(
      push: second-variable-name-paren-body
    - include: second-variable-name-content

  second-variable-name-paren-body:
    - match: \)
      pop: 1
    - include: continuation-or-eol-pop
    - include: paren-second-variable-name-content

  second-variable-name-content:
    - include: escaped-chars
    - include: second-escaped-dollars
    - include: second-expansions
    - include: expansions

###[ LITERALS ]################################################################

  comma-separators:
    - match: \s*(\,)\s*
      captures:
        1: punctuation.separator.sequence.makefile
      push: clear2-pop

  escaped-chars:
    - match: \\.
      scope: constant.character.escape.makefile

  escaped-dollars:
    - match: \${2}
      scope: constant.character.escape.makefile

  second-escaped-dollars:
    - match: \${4}
      scope: constant.character.escape.makefile

  percentage-placeholders:
    - match: \%
      scope: variable.language.makefile

###[ SHELLSCRIPT ]#############################################################

  shell-body:
    - meta_content_scope: source.shell.embedded.makefile
    - include: eol-pop
    - include: shell-content

  # Note: target context for shell syntax
  shell-content:
    - include: variable-name-content

  # Note: target context for shell syntax
  second-shell-content:
    - include: second-variable-name-content

###[ PROTOTYPES ]##############################################################

  continuation-or-eol-pop:
    - include: eol-pop
    - include: line-continuations

  eol-pop:
    - match: $
      pop: 1

  clear-pop:
    - clear_scopes: 1
    - meta_include_prototype: false
    - match: ''
      pop: 1

  clear2-pop:
    - clear_scopes: 2
    - meta_include_prototype: false
    - match: ''
      pop: 1

  immediately-pop:
    - meta_include_prototype: false
    - match: ''
      pop: 1

  line-continuations:
    - match: (\\)$
      captures:
        1: punctuation.separator.continuation.line.makefile
      push: line-continuation-body

  line-continuation-body:
    - meta_include_prototype: false
    - match: ^
      pop: 1

###############################################################################

variables:

  recipe_prefix: \t
  recipe_modifier: '[-+]@?|@[-+]?'

  directive_break: (?:\s+|{{word_break}})

  word_begin: (?=\S)
  word_break: (?![^\s:#!?+=])

  shell_assign: '!='
  var_assign: (?:\?|\+|:{1,3})?=
  var_or_shell_assign: (?:!|\?|\+|:{1,3})?=

  var_auto_chars: '@%<\?\^\+\|\*'

  builtin_functions: |-
    (?x:
      abspath
    | addprefix
    | addsuffix
    | and
    | basename
    | dir
    | eval
    | file
    | findstring
    | firstword
    | flavor
    | guile
    | if
    | intcmp
    | join
    | lastword
    | notdir
    | or
    | origin
    | realpath
    | sort
    | strip
    | subst
    | suffix
    | value
    | word
    | wordlist
    | words
    )

  message_functions: |-
    (?x:
      info
    | warning
    | error
    )

  pattern_functions: |-
    (?x:
      filter-out
    | filter
    | patsubst
    )

  posix_classes: |-
    (?x:
      alnum
    | alpha
    | blank
    | cntrl
    | digit
    | graph
    | lower
    | print
    | punct
    | space
    | upper
    | xdigit
    )
