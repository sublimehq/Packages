  glob-content:
    - include: string-content
    # 4.4 Using Wildcard Characters in File Names
    # Note: Copied from Bash.sublime-syntax
    - match: (?=\[)
      branch_point: glob-character-class
      branch:
        - glob-character-class
        - glob-character-class-fallback
    - match: \*
      scope: constant.other.wildcard.asterisk.makefile
    - match: \?
      scope: constant.other.wildcard.questionmark.makefile

  glob-character-class:
    - clear_scopes: 2
    - meta_include_prototype: false
    - meta_scope: meta.string.glob.makefile meta.character-class.glob.makefile string.unquoted.makefile
    - match: (\[)([!^]?)
      captures:
        1: punctuation.definition.character-class.begin.glob.makefile
        2: keyword.operator.logical.glob.makefile
      push:
        - glob-character-class-body
        - glob-character-class-begin

  glob-character-class-begin:
    - meta_include_prototype: false
    # a range may start with `]` at the beginning of a set
    - match: (?:(\\.)|.)(-)(?:(\\.)|[^\]$]|(?!\]))
      scope: constant.other.range.glob.makefile
      captures:
        1: constant.character.escape.glob.makefile
        2: punctuation.separator.sequence.glob.makefile
        3: constant.character.escape.glob.makefile
      pop: 1
