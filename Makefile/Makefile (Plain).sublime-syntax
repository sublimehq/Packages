%YAML 1.2
---
# https://www.gnu.org/software/make/manual/make.html
# https://www.sublimetext.com/docs/syntax.html
name: Makefile (Plain)
scope: source.makefile.plain
version: 2
hidden: true

contexts:

  # 3.1 What Makefiles Contain
  # Makefiles contain five kinds of things: explicit rules, implicit rules,
  # variable definitions, directives, and comments.
  main:
    - include: comments
    - include: merge-conflict-markers
    - include: line-continuations
    - include: definition-directives
    - include: conditional-directives
    - include: shells
    - include: definitions

###[ COMMENTS ]################################################################

  comments:
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      push: comment-body

  comment:
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      set: comment-body

  comment-body:
    - meta_content_scope: comment.line.number-sign.makefile
    - include: line-continuations
    - match: \\\\
    # note: meta.eol is required for syntax based folding
    - match: $\n?
      scope: comment.line.number-sign.makefile meta.eol.makefile
      pop: 1

###[ MERGE CONFLICT MARKERS ]##################################################

  merge-conflict-markers:
    # see also: Diff.sublime-syntax#conflict-markers
    - match: ^(<{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.begin.diff
      captures:
        1: punctuation.section.block.begin.diff
        2: entity.name.section.diff
    - match: ^(>{7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.end.diff
      captures:
        1: punctuation.section.block.end.diff
        2: entity.name.section.diff
    - match: ^(\|{7}|={7})(?:\s+(\S.*?))?$\n?
      scope: meta.block.conflict.separator.diff
      captures:
        1: punctuation.section.block.diff
        2: entity.name.section.diff

###[ SHELLS ]##################################################################

  shells:
    - match: (?i)(SHELL)\s*(=)\s*
      captures:
        1: variable.other.makefile
        2: keyword.operator.assignment.makefile
      set: shell-value

  shell-value:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \s*$
      set: main
    - include: shell-value-content

  shell-value-content:
    # note: no escapes to avoid windows path separators augmenting e.g. cmd.exe
    - include: line-continuations
    - include: shell-value-comment
    - include: shell-selector
    - include: escaped-dollars
    - include: interpolations

  shell-value-comment:
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      push: shell-value-comment-body

  shell-value-comment-body:
    - clear_scopes: 2
    - meta_content_scope: comment.line.number-sign.makefile
    - include: comment-body

  shell-selector:
    - match: \b(?:cmd\.exe|command\.com)\b
      scope: meta.string.makefile string.unquoted.makefile constant.other.language-name.makefile
      set: shell-dosbatch-value
    - match: \b(?:ba)?sh\b
      scope: meta.string.makefile string.unquoted.makefile constant.other.language-name.makefile
      set: shell-bash-value
    - match: \bzsh\b
      scope: meta.string.makefile string.unquoted.makefile constant.other.language-name.makefile
      set: shell-zsh-value

  shell-dosbatch-value:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \s*$
      set: make-with-dosbatch
    - include: shell-value-content

  make-with-dosbatch:
    - include: scope:source.makefile.dosbatch

  shell-bash-value:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \s*$
      set: make-with-bash
    - include: shell-value-content

  make-with-bash:
    - include: scope:source.makefile.bash

  shell-zsh-value:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \s*$
      set: make-with-zsh
    - include: shell-value-content

  make-with-zsh:
    - include: scope:source.makefile.zsh

###[ DEFINITIONS ]#############################################################

  definitions:
    - match: '{{word_begin}}'
      branch_point: definitions
      branch:
        - variable-definition-name
        - rule-targets

  rule-targets:
    # Anything before the colon is part of the rule's name.
    - meta_content_scope: meta.function.makefile entity.name.function.makefile
    - match: \s*(::?)
      captures:
        1: punctuation.definition.rule.makefile
      set: after-rule-targets
    - include: line-continuations
    - include: variable-pattern-content

  after-rule-targets:
    - meta_scope: meta.function.makefile
    - include: line-continuations
    # target-specific variable (parsed by main context)
    - match: (?=(?:override|(?:un)?(?:define|export)){{word_break}}|[^=#]+{{var_or_shell_assign}})
      pop: 1
    # prerequisites
    - match: (?=\S)
      set: rule-prerequisites
    # recipes
    - match: $\n?
      set: rule-recipes

  rule-prerequisites:
    - meta_include_prototype: false
    - meta_content_scope: meta.function.arguments.makefile meta.string.makefile string.unquoted.makefile
    - match: \s*(\#)
      captures:
        1: comment.line.number-sign.makefile punctuation.definition.comment.makefile
      set: rule-comment-body
    - match: \s*$\n?
      scope: meta.function.makefile
      set: rule-recipes
    - match: (\s*(;))(\s*({{recipe_modifier}}))?
      captures:
        1: meta.function.makefile
        2: punctuation.terminator.makefile
        3: meta.function.body.makefile
        4: keyword.operator.recipe.makefile
      set:
        - rule-recipes
        - shell-body
    - include: line-continuations
    - include: second-pattern-content

  rule-comment-body:
    - meta_scope: meta.function.makefile
    - meta_content_scope: comment.line.number-sign.makefile
    - match: $\n?
      scope: comment.line.number-sign.makefile
      set: rule-recipes
    - include: line-continuations

  rule-recipes:
    - meta_content_scope: meta.function.body.makefile
    - match: ^({{recipe_prefix}})(?:\s*({{recipe_modifier}}))?
      captures:
        1: punctuation.definition.recipe.makefile
        2: keyword.operator.recipe.makefile
      push: shell-body
    - include: comments
    - include: merge-conflict-markers
    - include: conditional-directives
    - match: ^(?!\s*(ifn?(def|eq)|else|endif){{word_break}}|\n)
      pop: 1

  variable-definition-name:
    - meta_content_scope: variable.other.makefile
    - match: \s*({{shell_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: shell-body
    - match: \s*({{var_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: variable-value
    - include: continuation-or-eol-pop
    - include: comment
    - include: variable-name-content
    - match: ':'
      fail: definitions

  variable-value:
    - match: ((?:bash|sh)\s+-c\s+)(['"`])
      captures:
        1: meta.string.makefile string.unquoted.makefile
        2: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.begin.makefile
      embed: scope:source.shell.bash.embedded.makefile.expansion
      embed_scope: meta.string.makefile meta.interpolation.makefile source.shell.bash.embedded.makefile
      escape: (?!<\\)\2
      escape_captures:
        0: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.end.makefile
    - match: (zsh\s+-c\s+)(['"`])
      captures:
        1: meta.string.makefile string.unquoted.makefile
        2: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.begin.makefile
      embed: scope:source.shell.zsh.embedded.makefile.expansion
      embed_scope: meta.string.makefile meta.interpolation.makefile source.shell.zsh.embedded.makefile
      escape: (?!<\\)\2
      escape_captures:
        0: meta.string.makefile meta.interpolation.makefile punctuation.section.interpolation.end.makefile
    - match: ''
      set: variable-value-body

  variable-value-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - include: string-content

###[ DIRECTIVES ]##############################################################

  definition-directives:
    # definition directives
    - match: (override){{directive_break}}
      captures:
        1: keyword.control.override.makefile
    - match: (define){{directive_break}}
      scope: meta.directive.define.makefile
      captures:
        1: keyword.control.define.makefile
      push: define-directive-name-body
    - match: (export){{directive_break}}
      scope: meta.directive.export.makefile
      captures:
        1: keyword.control.export.makefile
      push: export-directive-name-body
    - match: (undefine){{directive_break}}
      scope: meta.directive.undefine.makefile
      captures:
        1: keyword.control.undefine.makefile
      push: undefine-directive-name-body
    - match: (unexport){{directive_break}}
      scope: meta.directive.undefine.makefile
      captures:
        1: keyword.control.unexport.makefile
      push: undefine-directive-name-body
    - match: (endef){{directive_break}}
      captures:
        1: invalid.illegal.stray.endef.makefile
    - match: (vpath){{directive_break}}
      scope: meta.directive.vpath.makefile
      captures:
        1: keyword.control.vpath.makefile
      push: vpath-pattern-body
    # include directives
    - match: (-)(include){{directive_break}}
      scope: meta.directive.include.makefile
      captures:
        1: keyword.operator.recipe.makefile
        2: keyword.control.import.makefile
      push: include-directive-body
    - match: (s?include){{directive_break}}
      scope: meta.directive.include.makefile
      captures:
        1: keyword.control.import.makefile
      push: include-directive-body
    - match: (-?)(load){{directive_break}}
      scope: meta.directive.load.makefile
      captures:
        1: keyword.operator.recipe.makefile
        2: keyword.control.import.makefile
      push: load-directive-body

  define-directive-name-body:
    - meta_content_scope: meta.directive.define.makefile variable.other.makefile
    - match: ({{var_or_shell_assign}})?\s*\n
      captures:
        1: keyword.operator.assignment.makefile
      set: define-directive-value-body
    - include: variable-name-content

  define-directive-value-body:
    - meta_include_prototype: false
    - meta_scope: meta.directive.define.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: ^\s*(endef){{word_break}}
      captures:
        1: keyword.control.endef.makefile
      pop: 1
    # keep in balance with nested define statements
    # see: https://github.com/sublimehq/Packages/issues/1998
    - match: ^\s*define{{word_break}}
      push: nested-define-directive-body
    - include: merge-conflict-markers

  nested-define-directive-body:
    - meta_include_prototype: false
    - match: ^\s*endef{{word_break}}
      pop: 1
    - include: merge-conflict-markers

  export-directive-name-body:
    - meta_content_scope: meta.directive.export.makefile variable.other.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - match: \s*({{var_assign}})\s*
      captures:
        1: keyword.operator.assignment.makefile
      set: export-variable-value-body
    - match: \s+
      scope: meta.directive.export.makefile
      set: export-directive-name-body
    - include: variable-name-content

  export-variable-value-body:
    - meta_include_prototype: false
    - meta_scope: meta.directive.export.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - include: variable-value-body

  include-directive-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.include.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - match: \s+
      scope: meta.directive.include.makefile
      set: include-directive-body
    - include: glob-content

  load-directive-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.load.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - match: \s+
      scope: meta.directive.load.makefile
      set: load-directive-body
    - match: (\()([^)]*)(\))
      scope: meta.parens.makefile
      captures:
        1: punctuation.section.parens.begin.makefile
        2: entity.name.symbol.makefile
        3: punctuation.section.parens.end.makefile
    - include: glob-content

  undefine-directive-name-body:
    - meta_content_scope: meta.directive.undefine.makefile variable.other.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - match: \s+
      scope: meta.directive.undefine.makefile
      set: undefine-directive-name-body
    - include: variable-name-content

  vpath-pattern-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.vpath.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - match: \s+
      scope: meta.directive.vpath.makefile
      set: vpath-directory-body
    - include: glob-content

  vpath-directory-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.directive.vpath.makefile meta.string.makefile string.unquoted.makefile
    - include: continuation-or-eol-pop
    - include: comment
    - include: string-content

###[ CONDITIONAL DIRECTIVES ]##################################################

  conditional-directives:
    # 7.2 Syntax of Conditionals
    - match: (ifn?def){{directive_break}}
      captures:
        1: keyword.control.conditional.if.makefile
      push: ifdef-directive-condition
    - match: ifn?eq{{word_break}}
      scope: keyword.control.conditional.if.makefile
      push: ifeq-directive-condition
    - match: else{{word_break}}
      scope: meta.directive.conditional.else.makefile keyword.control.conditional.else.makefile
      branch_point: maybe-elseif
      branch:
        - else-if-directive
        - else-directive
    - match: endif{{word_break}}
      scope: meta.directive.conditional.endif.makefile keyword.control.conditional.endif.makefile

  else-if-directive:
    # Note: required for syntax based folding
    # When followed by an if directive else keyword acts as fold region terminator,
    # but only the eol after the if directive starts a new fold region.
    - include: comments
    - match: (ifn?def){{directive_break}}
      captures:
        1: keyword.control.conditional.if.makefile
      set: ifdef-directive-condition
    - match: ifn?eq{{word_break}}
      scope: keyword.control.conditional.if.makefile
      set: ifeq-directive-condition
    - match: (?=\S)
      fail: maybe-elseif

  else-directive:
    # Note: required for syntax based folding
    # The eol after a plain else directive starts a new fold region.
    - meta_content_scope: meta.directive.conditional.else.makefile
    - match: \s*$
      scope: meta.directive.conditional.else.makefile meta.eol.makefile
      pop: 1
    - include: line-continuations
    - include: comments

  ifdef-directive-condition:
    - meta_scope: meta.directive.conditional.if.makefile
    - meta_content_scope: variable.other.makefile
    - include: if-directive-end
    - include: variable-name-content

  ifeq-directive-condition:
    - meta_scope: meta.directive.conditional.if.makefile
    - include: if-directive-end
    - match: \(
      scope: punctuation.section.group.begin.makefile
      push: ifeq-group-body
    - match: \"
      scope: punctuation.definition.string.begin.makefile
      push: ifeq-double-quoted-arg-body
    - match: \'
      scope: punctuation.definition.string.begin.makefile
      push: ifeq-single-quoted-arg-body
    - match: '[^\s#]+'
      scope: invalid.illegal.stray.makefile

  ifeq-group-body:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.group.makefile
    - meta_content_scope: meta.string.makefile string.unquoted.makefile
    - match: \)
      scope: punctuation.section.group.end.makefile
      pop: 1
    - include: continuation-or-eol-pop
    - include: escaped-dollars
    - include: interpolations
    - include: comma-separators

  ifeq-double-quoted-arg-body:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.string.makefile string.quoted.double.makefile
    - match: \"
      scope: punctuation.definition.string.end.makefile
      pop: 1
    - match: $\n?
      scope: meta.eol.makefile invalid.illegal.unclosed-string.makefile
      pop: 1
    - include: line-continuations
    - include: escaped-dollars
    - include: interpolations

  ifeq-single-quoted-arg-body:
    # note: no escape sequences supported!
    - meta_include_prototype: false
    - meta_scope: meta.string.makefile string.quoted.single.makefile
    - match: \'
      scope: punctuation.definition.string.end.makefile
      pop: 1
    - match: $\n?
      scope: meta.eol.makefile invalid.illegal.unclosed-string.makefile
      pop: 1
    - include: line-continuations
    - include: escaped-dollars
    - include: interpolations

  if-directive-end:
    # Note: required for syntax based folding
    # The eol after an if directive starts a new fold region.
    - match: \s*$
      scope: meta.eol.makefile
      pop: 1
    - include: line-continuations
    - include: comments

###[ SINGLE EXPANSIONS ]#######################################################

  interpolations:
    - match: (\$)(\{)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push:
        - clear-pop
        - brace-expansion-begin
    - match: (\$)(\()
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push:
        - clear-pop
        - paren-expansion-begin
    - match: (\$)(?:([{{var_auto_chars}}])|([[:alpha:]]))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: variable.language.automatic.makefile
        3: variable.other.makefile
      push: clear-pop

  expansions:
    - match: (\$)(\{)
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: brace-expansion-begin
    - match: (\$)(\()
      captures:
        1: punctuation.definition.interpolation.makefile
        2: punctuation.section.interpolation.begin.makefile
      push: paren-expansion-begin
    - match: (\$)(?:([{{var_auto_chars}}])|([[:alpha:]]))
      scope: meta.interpolation.makefile
      captures:
        1: punctuation.definition.interpolation.makefile
        2: variable.language.automatic.makefile
        3: variable.other.makefile

  brace-expansion-begin:
    - meta_include_prototype: false
    - meta_scope: meta.interpolation.makefile
    # makefile command expansions
    - match: (call)\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-call-function-body
    - match: (shell)\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-shell-function-body
    - match: (foreach)\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-foreach-function-body
    - match: (wildcard)\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-wildcard-function-body
    - match: ({{pattern_functions}})\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-pattern-function-body
    - match: ({{message_functions}})\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-message-function-body
    - match: ({{builtin_functions}})\s+
      scope: meta.function-call.makefile
      captures:
        1: support.function.builtin.makefile
      set: brace-expansion-function-body
    # makefile variable expansions
    - match: '[{{var_auto_chars}}][DF]?'
      scope: variable.language.automatic.makefile
      set: brace-variable-substitution
    - match: ''
      set: brace-expansion-variable-name-body

  brace-expansion-call-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.makefile variable.function.makefile
    - include: brace-expansion-end
    - match: \,
      scope: meta.interpolation.makefile meta.function-call.makefile punctuation.separator.sequence.makefile
      set: brace-expansion-function-body
    - include: brace-variable-name-content

  brace-expansion-foreach-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile variable.other.makefile
    - include: brace-expansion-end
    - match: \,
      scope: meta.interpolation.makefile meta.function-call.arguments.makefile punctuation.separator.sequence.makefile
      set: brace-expansion-function-body
    - include: brace-variable-pattern-content

  brace-expansion-message-function-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - include: brace-expansion-end
    - include: brace-string-content

  brace-expansion-pattern-function-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - include: brace-expansion-end
    - include: comma-separators
    - include: brace-pattern-content

  brace-expansion-wildcard-function-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile meta.string.glob.makefile string.unquoted.makefile
    - include: brace-expansion-end
    - include: comma-separators
    - include: brace-glob-content

  brace-expansion-function-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile meta.string.makefile string.unquoted.makefile
    - include: brace-expansion-end
    - include: comma-separators
    - include: brace-string-content

  brace-expansion-shell-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile source.shell.embedded.makefile
    - include: brace-expansion-end
    - include: shell-content

  brace-expansion-variable-name-body:
    - meta_content_scope: meta.interpolation.makefile variable.other.makefile
    - include: brace-variable-substitution
    - include: brace-variable-pattern-content

  brace-variable-substitution:
    - match: ':'
      scope: meta.interpolation.makefile punctuation.definition.substitution.makefile
      set: brace-variable-substitution-body
    - include: brace-expansion-end

  brace-variable-substitution-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - match: =
      scope: meta.interpolation.makefile keyword.operator.assignment.makefile
      set: brace-variable-replacement-body
    - include: brace-expansion-end
    - include: pattern-content

  brace-variable-replacement-body:
    - meta_include_prototype: false
    - meta_content_scope: meta.interpolation.makefile string.unquoted.makefile
    - include: brace-expansion-end
    - include: pattern-content

  brace-expansion-end:
    - match: \}
      scope: meta.interpolation.makefile punctuation.section.interpolation.end.makefile
      pop: 1
    - include: continuation-or-eol-pop

  paren-expansion-begin:
