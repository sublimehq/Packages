%YAML 1.2
---
# https://www.gnu.org/software/make/manual/make.html
# https://www.sublimetext.com/docs/syntax.html
name: Makefile (Zsh)
scope: source.makefile.zsh
version: 2

extends: Makefile (Plain).sublime-syntax

contexts:

###[ EXPANSIONS ]##############################################################

  brace-expansion-shell-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile source.shell.zsh.embedded.makefile
    - include: brace-expansion-end
    - include: shell-content

  paren-expansion-shell-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile source.shell.zsh.embedded.makefile
    - include: paren-expansion-end
    - include: shell-content

  brace-second-expansion-shell-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile source.shell.zsh.embedded.makefile
    - include: brace-expansion-end
    - include: second-shell-content

  paren-second-expansion-shell-function-body:
    - meta_content_scope: meta.interpolation.makefile meta.function-call.arguments.makefile source.shell.zsh.embedded.makefile
    - include: paren-expansion-end
    - include: second-shell-content

###[ SHELLSCRIPT ]#############################################################

  shell-body:
    - meta_content_scope: source.shell.zsh.embedded.makefile
    - include: eol-pop
    - include: shell-content

  shell-content:
    - include: Packages/Makefile/Embeddings/Zsh (for Makefile 1).sublime-syntax
      apply_prototype: true

  second-shell-content:
    - include: Packages/Makefile/Embeddings/Zsh (for Makefile 2).sublime-syntax
      apply_prototype: true
